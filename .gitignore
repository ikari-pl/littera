# Littera gitignore

# Embedded Postgres binaries and build artifacts
.littera/pg/
*.pyc
__pycache__/

# Development caches and state
.pytest_cache/
.coverage/
.eggs/
dist/
build/
*.egg-info/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Tauri build artifacts
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Node.js (ProseMirror editor build)
desktop/node_modules/
desktop/src/editor.bundle.js
desktop/src/editor.bundle.js.map

# PoliMorf source TSV (large, download separately)
scripts/polimorf.tab

# Test work directory
my-work/

# Beads local DB / backups (tracked issues live in issues.jsonl)
.beads/backup/
.beads/embeddeddolt/
.beads/.auto-import-issues.jsonl

# Agent / tooling local state
.claude/
.cursor/
.omc/
.skillshare/
.playwright-mcp/
.envrc

# Ad-hoc UI screenshots and Playwright output
*.png
desktop/test-results/

# beads local lock files
*.gate.lock
.beads/*.gate.lock
